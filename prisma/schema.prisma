// ============================================
// LifeOS - Prisma Schema
// PostgreSQL + Prisma
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_NON_POOLING")
}

// ----------------------------------------------------------
// ENUMS
// ----------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ResourceStatus {
  TO_READ
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ResourceVaultCategory {
  ESTUDOS
  LAZER
  FERRAMENTAS
}

enum JourneyStepStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

enum WishCategory {
  ASSINATURAS
  ELETRONICOS
  JOGOS
  LAZER
}

enum FixedExpenseGroup {
  PLANOS
  INVESTIMENTOS
  GERAL
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  FORMER
}

enum ProjectStatus {
  IDEA
  ACTIVE
  PAUSED
  DELIVERED
  ARCHIVED
}

enum ServerStatus {
  ONLINE
  MAINTENANCE
  OFFLINE
}

// ----------------------------------------------------------
// USERS / AUTH
// ----------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  avatarUrl     String?
  role          Role     @default(USER)
  isApproved    Boolean  @default(false)
  emailVerified DateTime?
  onboardedAt   DateTime?
  timezone      String   @default("America/Sao_Paulo")
  locale        String   @default("pt-BR")
  currency      String   @default("BRL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  notifications     Notification[]
  investments       Investment[]
  wishItems         WishItem[]
  fixedExpenses     FixedExpense[]
  receivables       Receivable[]
  fixedReceivables  FixedReceivable[]
  resources         Resource[]
  journeys          Journey[]
  customers         Customer[]
  vpsServers        VpsServer[]
  projects          Project[]

  @@index([email])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ----------------------------------------------------------
// INVESTMENTS
// ----------------------------------------------------------

model Investment {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Decimal  @db.Decimal(14, 2)
  type      String   // CDB, Tesouro, Ações, FIIs, ETFs, Cripto, Outros, ...
  color     String   @default("#22c55e")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------
// DESEJOS — lista de consumo
// ----------------------------------------------------------

model WishItem {
  id          String       @id @default(cuid())
  userId      String
  name        String
  price       Decimal      @db.Decimal(14, 2)
  link        String?
  description String?
  category    WishCategory @default(ELETRONICOS)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

// ----------------------------------------------------------
// GASTOS FIXOS — despesas recorrentes mensais
// ----------------------------------------------------------

model FixedExpense {
  id        String            @id @default(cuid())
  userId    String
  name      String
  amount    Decimal           @db.Decimal(14, 2)
  dueDate   Int
  paid      Boolean           @default(false)
  group     FixedExpenseGroup @default(GERAL)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, group])
}

// ----------------------------------------------------------
// A RECEBER — quem deve ao usuário
// ----------------------------------------------------------

model Receivable {
  id         String   @id @default(cuid())
  userId     String
  debtorName String
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------
// A RECEBER — valores fixos mensais e meses já pagos
// ----------------------------------------------------------

model FixedReceivable {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Decimal  @db.Decimal(14, 2)
  dueDay    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments FixedReceivablePayment[]

  @@index([userId])
}

model FixedReceivablePayment {
  id                String   @id @default(cuid())
  fixedReceivableId String
  year              Int
  month             Int
  createdAt         DateTime @default(now())

  fixedReceivable FixedReceivable @relation(fields: [fixedReceivableId], references: [id], onDelete: Cascade)

  @@unique([fixedReceivableId, year, month])
  @@index([fixedReceivableId, year])
}

// ----------------------------------------------------------
// RESOURCES (Vault) — links / artigos / recursos para depois
// ----------------------------------------------------------

model Resource {
  id            String               @id @default(cuid())
  userId        String
  title         String
  url           String
  description   String?
  // Categoria principal: Estudos, Lazer ou Ferramentas
  vaultCategory ResourceVaultCategory @default(ESTUDOS)
  // Rótulo legado opcional (Artigo, Vídeo, etc.)
  category      String?
  status        ResourceStatus       @default(TO_READ)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, vaultCategory])
}

// ----------------------------------------------------------
// GESTÃO — clientes, VPS e projetos vinculados
// ----------------------------------------------------------

model Customer {
  id        String       @id @default(cuid())
  userId    String
  name      String
  company   String?
  email     String?
  phone     String?
  website   String?
  status    ClientStatus @default(ACTIVE)
  color     String       @default("#6366f1")
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId, status])
}

model VpsServer {
  id               String       @id @default(cuid())
  userId           String
  name             String
  provider         String?
  hostname         String?
  ipAddress        String?
  operatingSystem  String?
  region           String?
  cpu              String?
  ramGb            Int?
  diskGb           Int?
  status           ServerStatus @default(ONLINE)
  monthlyCost      Decimal?     @db.Decimal(14, 2)
  panelUrl         String?
  color            String       @default("#0ea5e9")
  backupNotes      String?
  folderStructure  String?
  hostedNotes      String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId, status])
}

model Project {
  id             String        @id @default(cuid())
  userId         String
  name           String
  summary        String?
  specification  String?
  status         ProjectStatus @default(ACTIVE)
  color          String        @default("#22c55e")
  customerId     String?
  serverId       String?
  stack          String[]      @default([])
  repoUrl        String?
  liveUrl        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  server   VpsServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([customerId])
  @@index([serverId])
}

// ----------------------------------------------------------
// JORNADA — missões gamificadas (árvore de passos)
// ----------------------------------------------------------

model Journey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps JourneyStep[]

  @@index([userId])
}

model JourneyStep {
  id          String             @id @default(cuid())
  journeyId   String
  title       String
  description String?
  url         String?
  instructor  String?
  difficulty  Int                @default(1)
  xpReward    Int                @default(100)
  order       Int
  status      JourneyStepStatus  @default(LOCKED)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, order])
}
